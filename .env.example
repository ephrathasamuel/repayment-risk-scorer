# Copy to .env and fill in. .env is git-ignored.

# Long random string used to sign sessions (python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# Accounts created when the API starts, if they don't exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ANALYST_EMAIL=analyst@example.com
ANALYST_PASSWORD=

# Optional: AI decision notes (Claude). Without it, everything else works.
ANTHROPIC_API_KEY=

# Optional: defaults to SQLite in data/app.db. Docker Compose sets PostgreSQL.
# DATABASE_URL=postgresql+psycopg://scorer:scorer@localhost:5432/scorer

# Set to true when served over HTTPS
COOKIE_SECURE=false
